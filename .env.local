# Truest whitelabel — local/demo configuration.
#
# This file is gitignored (.gitignore ignores .env*). Keep it that way: the
# partner API key below is a secret.

# ---------------------------------------------------------------------------
# Whitelabel mode
# ---------------------------------------------------------------------------
# Turns off nulink-root SSO and serves this app's own /login page instead.
NEXT_PUBLIC_WHITELABEL_MODE=true

# ---------------------------------------------------------------------------
# Demo credentials (server-side only — no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# Stand-in for Truest's own user directory. Checked by
# src/app/whitelabel/session/route.ts, never sent to the browser.
WHITELABEL_DEMO_EMAIL=demo@truest.ae
WHITELABEL_DEMO_PASSWORD=truest-demo-2026

# ---------------------------------------------------------------------------
# Partner API (nulink-root) — server-side only
# ---------------------------------------------------------------------------
# This key authenticates Truest as a partner. It must never carry a
# NEXT_PUBLIC_ prefix, or Next.js inlines it into the browser bundle.
PARTNER_API_KEY=nlk_F2lPuqq9evvTNlRi3Bvn4Eu2y5dr3FGX6K0HBXKG8wE
PARTNER_API_URL=https://rapi.nulinksec.com/api/v1

# The client organization the demo user signs in as.
#
# In a real partner platform this lives in the partner's own database, stored
# against the user record when their organization is first provisioned. Here
# the demo user is a single hardcoded account, so its org id is pinned here
# instead. Setting it skips provisioning entirely: every sign-in goes straight
# to minting an access code for this org, so the data is always the same.
#
# Provisioned 2026-10-24 via POST /partner/orgs.
# Service owner: truest_demo_svc.99385deb@clients.nulink.invalid
PARTNER_ORG_ID=a7e1a1c5-00eb-4626-a4b5-fc994814ee6b

# Only used if PARTNER_ORG_ID is cleared, in which case provisioning
# runs and resolves back to the SAME org, because it is idempotent on
# external_id. These must keep matching the org above or a second, empty
# organization would be created instead.
PARTNER_EXTERNAL_ID=046e2279-8d9d-4d1a-b45b-ad5b7960641b
PARTNER_CLIENT_NAME=Truest Demo

# ---------------------------------------------------------------------------
# Exposure Management API
# ---------------------------------------------------------------------------
# Setting this disables the local /api/* dev proxy and makes the browser call
# eapi directly, so eapi's ALLOWED_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=https://eapi.nulinksec.com
